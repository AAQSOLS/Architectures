# =============================================================================
# YourApp .editorconfig
# Enforces the tooling-checkable rules of docs/ARCHITECTURE.md.
# Structural rules (layer/module/host boundaries, enums-only, sealed public
# models, entity exposure) are enforced by tests/Architecture.Tests instead.
# Requires: Directory.Build.props (EnforceCodeStyleInBuild, TreatWarningsAsErrors),
#           StyleCop.Analyzers + stylecop.json, BannedApiAnalyzers + BannedSymbols.txt
# Optional: SonarAnalyzer.CSharp (Sonar rules have no effect without it)
# Section order matters: later, more specific sections override earlier ones.
# =============================================================================
root = true

# -----------------------------------------------------------------------------
# 1. Everything
# -----------------------------------------------------------------------------
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,csproj,props,targets,xml,html,cshtml,ts,scss}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.sql]
end_of_line = crlf
indent_size = 4

# -----------------------------------------------------------------------------
# 2. C# baseline
# -----------------------------------------------------------------------------
[*.cs]

# --- Namespaces: namespace == folder path, file-scoped (ARCHITECTURE §4.5) ---
csharp_style_namespace_declarations = file_scoped:error
dotnet_style_namespace_match_folder = true
dotnet_diagnostic.IDE0130.severity = error
dotnet_diagnostic.IDE0161.severity = error

# --- Explicit accessibility everywhere ("internal sealed", never implicit) ---
dotnet_style_require_accessibility_modifiers = always:error
dotnet_diagnostic.IDE0040.severity = error

# --- Sealed by default: unsealed internal types with no subclasses are errors ---
# (public models/contracts must also be sealed: architecture test A12)
dotnet_diagnostic.CA1852.severity = error

# --- Usings and dead code ---
dotnet_diagnostic.IDE0005.severity = warning
dotnet_diagnostic.IDE0044.severity = suggestion  # add readonly modifier
dotnet_diagnostic.IDE0049.severity = suggestion  # use language keywords (int, not Int32)
dotnet_diagnostic.IDE0051.severity = warning
dotnet_diagnostic.IDE0052.severity = warning
dotnet_diagnostic.IDE0059.severity = warning     # unnecessary assignment
dotnet_diagnostic.IDE0072.severity = warning     # add missing cases to switch
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# --- Predefined types (int, string) instead of BCL names (Int32, String) ---
dotnet_style_predefined_type_for_locals_parameters_members = true:suggestion
dotnet_style_predefined_type_for_member_access = true:suggestion

# --- Async correctness ---
dotnet_diagnostic.CA2012.severity = warning     # use ValueTasks correctly
dotnet_diagnostic.CA2016.severity = warning     # forward CancellationToken
dotnet_diagnostic.CA2007.severity = none        # ASP.NET Core: no ConfigureAwait noise
dotnet_diagnostic.CS4014.severity = error       # un-awaited call
dotnet_diagnostic.CS1998.severity = warning     # async without await
dotnet_diagnostic.CA1849.severity = suggestion  # sync call inside async method

# --- Analyzer categories ---
dotnet_analyzer_diagnostic.category-Security.severity = warning
dotnet_analyzer_diagnostic.category-Reliability.severity = warning
dotnet_analyzer_diagnostic.category-Performance.severity = suggestion
dotnet_diagnostic.CA2100.severity = error       # review SQL for injection

# --- Banned APIs (BannedSymbols.txt): DateTime.Now/UtcNow, IgnoreQueryFilters ---
dotnet_diagnostic.RS0030.severity = error

# --- Language style (light touch; not architecture) ---
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion
csharp_prefer_braces = true:warning
csharp_style_prefer_primary_constructors = true:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_prefer_pattern_matching = true:suggestion
csharp_style_prefer_switch_expression = true:suggestion
csharp_style_prefer_null_check_over_type_check = true:suggestion
dotnet_style_prefer_collection_expression = when_types_loosely_match:suggestion
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_indent_case_contents = true
csharp_indent_switch_labels = true

# -----------------------------------------------------------------------------
# 3. StyleCop: use ONLY for file rules (one type per file, file name = type)
#    Turn every StyleCop category off, then re-enable just the two rules we need.
#    (If a category name below stops matching, disable the noisy SAxxxx IDs
#    individually instead. Verify with a deliberately failing file.)
# -----------------------------------------------------------------------------
[*.cs]
dotnet_analyzer_diagnostic.category-StyleCop.CSharp.DocumentationRules.severity = none
dotnet_analyzer_diagnostic.category-StyleCop.CSharp.LayoutRules.severity = none
dotnet_analyzer_diagnostic.category-StyleCop.CSharp.NamingRules.severity = none
dotnet_analyzer_diagnostic.category-StyleCop.CSharp.OrderingRules.severity = none
dotnet_analyzer_diagnostic.category-StyleCop.CSharp.ReadabilityRules.severity = none
dotnet_analyzer_diagnostic.category-StyleCop.CSharp.SpacingRules.severity = none
dotnet_analyzer_diagnostic.category-StyleCop.CSharp.SpecialRules.severity = none
dotnet_analyzer_diagnostic.category-StyleCop.CSharp.MaintainabilityRules.severity = none

# One top-level type per file, and file name matches the type: ON by default...
dotnet_diagnostic.SA1402.severity = error
dotnet_diagnostic.SA1649.severity = error

# -----------------------------------------------------------------------------
# 4. Code safety rules (nullability, CA, Sonar, Roslynator)
# -----------------------------------------------------------------------------
[*.cs]

# --- Strict nullability ---
dotnet_diagnostic.CS8600.severity = warning     # null literal / possible null to non-nullable
dotnet_diagnostic.CS8601.severity = warning     # possible null reference assignment
dotnet_diagnostic.CS8602.severity = warning     # dereference of possibly null reference
dotnet_diagnostic.CS8603.severity = warning     # possible null reference return
dotnet_diagnostic.CS8604.severity = warning     # possible null reference argument
dotnet_diagnostic.CS8618.severity = warning     # non-nullable not initialized in constructor
dotnet_diagnostic.CS8619.severity = warning     # nullability mismatch in value
dotnet_diagnostic.CS8620.severity = warning     # argument nullability mismatch
dotnet_diagnostic.CS8625.severity = warning     # null literal to non-nullable reference
dotnet_diagnostic.CS8629.severity = warning     # nullable value type may be null
dotnet_diagnostic.CS8631.severity = warning     # type argument nullability / constraint
dotnet_diagnostic.CS8632.severity = warning     # '?' annotation outside nullable context
dotnet_diagnostic.CS8653.severity = warning     # default expression introduces null
dotnet_diagnostic.CS8669.severity = warning     # annotation in generated code
dotnet_diagnostic.CS8714.severity = warning     # type argument breaks notnull constraint
dotnet_diagnostic.CS8765.severity = warning     # override parameter nullability mismatch
dotnet_diagnostic.CS8767.severity = warning     # interface implementation nullability mismatch

# --- Microsoft.NetAnalyzers ---
dotnet_diagnostic.CA1309.severity = warning     # use ordinal string comparison
dotnet_diagnostic.CA1507.severity = warning     # use nameof instead of string literal
dotnet_diagnostic.CA2200.severity = warning     # rethrow to preserve stack details
dotnet_diagnostic.CA2254.severity = warning     # logging template should be static
dotnet_diagnostic.CA5394.severity = warning     # do not use insecure randomness
dotnet_diagnostic.CA1848.severity = suggestion  # use LoggerMessage delegates
dotnet_diagnostic.CA1851.severity = suggestion  # possible multiple enumeration (noisy)
dotnet_diagnostic.CA2000.severity = suggestion  # dispose before losing scope (S2930 is the warning)
dotnet_diagnostic.CA1000.severity = none        # static members on generic types (Result<T>)
dotnet_diagnostic.CA1008.severity = none        # enums should have zero value
dotnet_diagnostic.CA1030.severity = none        # use events where appropriate
dotnet_diagnostic.CA1034.severity = none        # do not nest types (constants/permissions grouped in static classes)
dotnet_diagnostic.CA1040.severity = none        # avoid empty interfaces (marker interfaces)
dotnet_diagnostic.CA1054.severity = none        # URI parameter type (raw URL strings in middleware/sanitizers)
dotnet_diagnostic.CA1055.severity = none        # URI return values (tokens containing Url are strings)
dotnet_diagnostic.CA1062.severity = suggestion  # validate arguments of public methods (NRT enabled)
dotnet_diagnostic.CA1308.severity = none        # normalize strings to uppercase (hex tokens are lowercase)
dotnet_diagnostic.CA1515.severity = none        # make types internal (controllers and Program must be public for test hosts)
dotnet_diagnostic.CA1711.severity = none        # incorrect identifier suffix
dotnet_diagnostic.CA1716.severity = none        # identifiers conflict with keywords
dotnet_diagnostic.CA1724.severity = none        # type name conflicts with namespace (DependencyInjection)
dotnet_diagnostic.CA1873.severity = none        # expensive argument evaluation in logging
dotnet_diagnostic.CA2225.severity = none        # operator overloads alternate method (Result<T> implicit conversions)

# --- SonarAnalyzer (needs the SonarAnalyzer.CSharp package) ---
dotnet_diagnostic.S112.severity = warning       # do not throw general exceptions
dotnet_diagnostic.S2139.severity = warning      # log or rethrow, not both
dotnet_diagnostic.S2221.severity = warning      # do not catch Exception when not required
dotnet_diagnostic.S2930.severity = warning      # IDisposables should be disposed
dotnet_diagnostic.S3247.severity = warning      # duplicate casts
dotnet_diagnostic.S3649.severity = warning      # SQL injection (needs SonarQube/SonarCloud taint analysis)
dotnet_diagnostic.S2094.severity = suggestion   # empty classes
dotnet_diagnostic.S2365.severity = suggestion   # properties copying collections
dotnet_diagnostic.S3011.severity = none         # reflection accessibility bypass (EF Core query filter)
dotnet_diagnostic.S3241.severity = suggestion   # method return type used as fluent builder
dotnet_diagnostic.S5122.severity = suggestion   # permissive default CORS policy for development starter
dotnet_diagnostic.S3604.severity = none         # redundant member initializers
dotnet_diagnostic.S1135.severity = none         # track TODO comments
dotnet_diagnostic.S2326.severity = none         # unused type parameter (CQRS marker interfaces)

# --- Roslynator: off by default, enable only what we want ---
roslynator_analyzers.enabled_by_default = false
dotnet_diagnostic.RCS1079.severity = suggestion # throwing NotImplementedException
dotnet_diagnostic.RCS1233.severity = suggestion # use short-circuiting operator

# --- Meziantou.Analyzer ---
dotnet_diagnostic.MA0004.severity = none         # ConfigureAwait(false) not needed in ASP.NET Core apps
dotnet_diagnostic.MA0048.severity = none         # Allow CQRS slice DTOs co-located in single file
dotnet_diagnostic.MA0051.severity = none         # Method length limit (DI configuration methods exceed 60 lines)

# -----------------------------------------------------------------------------
# 5. Naming rules (global)
# -----------------------------------------------------------------------------
[*.cs]
# Interfaces start with I
dotnet_naming_rule.interfaces_start_with_i.symbols = interfaces
dotnet_naming_rule.interfaces_start_with_i.style = begins_with_i
dotnet_naming_rule.interfaces_start_with_i.severity = error
dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_symbols.interfaces.applicable_accessibilities = *
dotnet_naming_style.begins_with_i.required_prefix = I
dotnet_naming_style.begins_with_i.capitalization = pascal_case

# Types, methods, properties, events: PascalCase
dotnet_naming_rule.types_pascal.symbols = all_types
dotnet_naming_rule.types_pascal.style = pascal_case_style
dotnet_naming_rule.types_pascal.severity = error
dotnet_naming_symbols.all_types.applicable_kinds = class, struct, enum, delegate
dotnet_naming_symbols.all_types.applicable_accessibilities = *
dotnet_naming_style.pascal_case_style.capitalization = pascal_case

dotnet_naming_rule.members_pascal.symbols = pascal_members
dotnet_naming_rule.members_pascal.style = pascal_case_style
dotnet_naming_rule.members_pascal.severity = error
dotnet_naming_symbols.pascal_members.applicable_kinds = method, property, event
dotnet_naming_symbols.pascal_members.applicable_accessibilities = *

# Type parameters: TPrefix
dotnet_naming_rule.type_parameters_t_prefix.symbols = type_parameters
dotnet_naming_rule.type_parameters_t_prefix.style = begins_with_t
dotnet_naming_rule.type_parameters_t_prefix.severity = suggestion
dotnet_naming_symbols.type_parameters.applicable_kinds = type_parameter
dotnet_naming_symbols.type_parameters.applicable_accessibilities = *
dotnet_naming_style.begins_with_t.required_prefix = T
dotnet_naming_style.begins_with_t.capitalization = pascal_case

# Parameters and locals: camelCase
dotnet_naming_rule.parameters_camel.symbols = parameters
dotnet_naming_rule.parameters_camel.style = camel_case_style
dotnet_naming_rule.parameters_camel.severity = suggestion
dotnet_naming_symbols.parameters.applicable_kinds = parameter
dotnet_naming_style.camel_case_style.capitalization = camel_case

dotnet_naming_rule.locals_camel.symbols = locals
dotnet_naming_rule.locals_camel.style = camel_case_style
dotnet_naming_rule.locals_camel.severity = suggestion
dotnet_naming_symbols.locals.applicable_kinds = local

# Private/internal fields: _camelCase
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel
dotnet_naming_rule.private_fields_underscore.severity = error
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private, private_protected, internal
dotnet_naming_style.underscore_camel.required_prefix = _
dotnet_naming_style.underscore_camel.capitalization = camel_case

# Constants and static readonly: PascalCase
dotnet_naming_rule.constants_pascal.symbols = constants
dotnet_naming_rule.constants_pascal.style = pascal_case_style
dotnet_naming_rule.constants_pascal.severity = error
dotnet_naming_symbols.constants.applicable_kinds = field
dotnet_naming_symbols.constants.applicable_accessibilities = *
dotnet_naming_symbols.constants.required_modifiers = const

# Async methods end with Async (controller actions exempted in section 7)
dotnet_naming_rule.async_suffix.symbols = async_methods
dotnet_naming_rule.async_suffix.style = ends_with_async
dotnet_naming_rule.async_suffix.severity = error
dotnet_naming_symbols.async_methods.applicable_kinds = method
dotnet_naming_symbols.async_methods.applicable_accessibilities = *
dotnet_naming_symbols.async_methods.required_modifiers = async
dotnet_naming_style.ends_with_async.required_suffix = Async
dotnet_naming_style.ends_with_async.capitalization = pascal_case

# Type-name suffix styles reused by the folder sections below
dotnet_naming_style.suffix_service.required_suffix = Service
dotnet_naming_style.suffix_service.capitalization = pascal_case
dotnet_naming_style.suffix_validator.required_suffix = Validator
dotnet_naming_style.suffix_validator.capitalization = pascal_case
dotnet_naming_style.suffix_mappings.required_suffix = Mappings
dotnet_naming_style.suffix_mappings.capitalization = pascal_case
dotnet_naming_style.suffix_module.required_suffix = Module
dotnet_naming_style.suffix_module.capitalization = pascal_case
dotnet_naming_style.suffix_controller.required_suffix = Controller
dotnet_naming_style.suffix_controller.capitalization = pascal_case
dotnet_naming_style.suffix_model.required_suffix = Model
dotnet_naming_style.suffix_model.capitalization = pascal_case
dotnet_naming_style.suffix_configuration.required_suffix = Configuration
dotnet_naming_style.suffix_configuration.capitalization = pascal_case
dotnet_naming_style.suffix_repository.required_suffix = Repository
dotnet_naming_style.suffix_repository.capitalization = pascal_case
dotnet_naming_style.suffix_reader.required_suffix = Reader
dotnet_naming_style.suffix_reader.capitalization = pascal_case
dotnet_naming_style.suffix_sps.required_suffix = Sps
dotnet_naming_style.suffix_sps.capitalization = pascal_case
dotnet_naming_style.suffix_exception.required_suffix = Exception
dotnet_naming_style.suffix_exception.capitalization = pascal_case

dotnet_naming_symbols.classes_only.applicable_kinds = class
dotnet_naming_symbols.classes_only.applicable_accessibilities = *

# -----------------------------------------------------------------------------
# 6. One-type-per-file RELAXATIONS: use-case / screen files (ARCHITECTURE §8.6)
#    Application Models + Validators, API Contracts, MVC ViewModels may hold
#    several types per file (named after the use case).
# -----------------------------------------------------------------------------
[**/Application/**/Models/**.cs]
dotnet_diagnostic.SA1402.severity = none
dotnet_diagnostic.SA1649.severity = none

[**/Application/**/Validators/**.cs]
dotnet_diagnostic.SA1402.severity = none
dotnet_diagnostic.SA1649.severity = none

[**/Client.Api/Contracts/**.cs]
dotnet_diagnostic.SA1402.severity = none
dotnet_diagnostic.SA1649.severity = none

[**/ViewModels/**.cs]
dotnet_diagnostic.SA1402.severity = none
dotnet_diagnostic.SA1649.severity = none

# Application/Shared/Models holds true primitives (PagedResult<T>, LookupItem<T>):
# one type per file stays ENFORCED there.
[**/Application/Shared/Models/**.cs]
dotnet_diagnostic.SA1402.severity = error
dotnet_diagnostic.SA1649.severity = error

# Domain: one type per file, no exceptions. (Enums additionally must live in
# an Enums/ folder: architecture test A13.)
[**/src/Domain/**.cs]
dotnet_diagnostic.SA1402.severity = error
dotnet_diagnostic.SA1649.severity = error

# Top-level statements / generated files
[**/Program.cs]
dotnet_diagnostic.SA1649.severity = none
dotnet_diagnostic.SA1402.severity = none

# Generic primitives and companion result types
[{**/IRepository.cs,**/PagedResult.cs,**/EfRepository.cs}]
dotnet_diagnostic.SA1649.severity = none

[**/Result.cs]
dotnet_diagnostic.SA1402.severity = none
dotnet_diagnostic.SA1649.severity = none

# -----------------------------------------------------------------------------
# 7. Folder-scoped naming (type-name suffix by location, ARCHITECTURE §8.1 / §13)
#    Naming rules apply only to files matching the section glob.
# -----------------------------------------------------------------------------

# Application services: XxxService
[**/src/Application/*/Services/**.cs]
dotnet_naming_rule.app_services_suffix.symbols = classes_only
dotnet_naming_rule.app_services_suffix.style = suffix_service
dotnet_naming_rule.app_services_suffix.severity = error

# Application validators: XxxValidator
[**/src/Application/*/Validators/**.cs]
dotnet_naming_rule.app_validators_suffix.symbols = classes_only
dotnet_naming_rule.app_validators_suffix.style = suffix_validator
dotnet_naming_rule.app_validators_suffix.severity = error

# Application mapping registrations: {Module}Mappings
[**/src/Application/*/Mapping/**.cs]
dotnet_naming_rule.app_mappings_suffix.symbols = classes_only
dotnet_naming_rule.app_mappings_suffix.style = suffix_mappings
dotnet_naming_rule.app_mappings_suffix.severity = error

# Application module registration: {Module}Module (file at module root)
[**/src/Application/*/*Module.cs]
dotnet_naming_rule.app_module_suffix.symbols = classes_only
dotnet_naming_rule.app_module_suffix.style = suffix_module
dotnet_naming_rule.app_module_suffix.severity = error

# Host mapping registrations: {Module}Mappings
[**/apps/*/Mapping/**.cs]
dotnet_naming_rule.host_mappings_suffix.symbols = classes_only
dotnet_naming_rule.host_mappings_suffix.style = suffix_mappings
dotnet_naming_rule.host_mappings_suffix.severity = error

# Controllers: XxxController; async actions are NOT required to end in Async
[**/Controllers/**.cs]
dotnet_naming_rule.controllers_suffix.symbols = classes_only
dotnet_naming_rule.controllers_suffix.style = suffix_controller
dotnet_naming_rule.controllers_suffix.severity = error
dotnet_naming_rule.async_suffix.severity = none

# MVC ViewModels folder: every type ends in Model (FormModel / ViewModel)
[**/Admin.Mvc/Areas/**/ViewModels/**.cs]
dotnet_naming_rule.mvc_models_suffix.symbols = classes_only
dotnet_naming_rule.mvc_models_suffix.style = suffix_model
dotnet_naming_rule.mvc_models_suffix.severity = error

# EF configurations: XxxConfiguration
[**/Persistence/Configurations/**.cs]
dotnet_naming_rule.ef_config_suffix.symbols = classes_only
dotnet_naming_rule.ef_config_suffix.style = suffix_configuration
dotnet_naming_rule.ef_config_suffix.severity = error

# Repositories: XxxRepository
[**/Persistence/Repositories/**.cs]
dotnet_naming_rule.repo_suffix.symbols = classes_only
dotnet_naming_rule.repo_suffix.style = suffix_repository
dotnet_naming_rule.repo_suffix.severity = error

# Readers: XxxReader
[**/Persistence/Readers/**.cs]
dotnet_naming_rule.reader_suffix.symbols = classes_only
dotnet_naming_rule.reader_suffix.style = suffix_reader
dotnet_naming_rule.reader_suffix.severity = error

# SP name constants: {Module}Sps
[**/Persistence/StoredProcedures/SpNames/**.cs]
dotnet_naming_rule.sps_suffix.symbols = classes_only
dotnet_naming_rule.sps_suffix.style = suffix_sps
dotnet_naming_rule.sps_suffix.severity = error

# Domain exceptions: XxxException
[**/src/Domain/**/*Exception.cs]
dotnet_naming_rule.domain_exception_suffix.symbols = classes_only
dotnet_naming_rule.domain_exception_suffix.style = suffix_exception
dotnet_naming_rule.domain_exception_suffix.severity = error

# -----------------------------------------------------------------------------
# 8. Banned-API carve-outs (RS0030). See BannedSymbols.txt.
# -----------------------------------------------------------------------------
# IgnoreQueryFilters / platform SPs: ONLY the Platform readers may use them
[**/Persistence/Readers/Platform/**.cs]
dotnet_diagnostic.RS0030.severity = none

# The clock implementation is the only place allowed to read the system time
[**/SystemClock.cs]
dotnet_diagnostic.RS0030.severity = none

# -----------------------------------------------------------------------------
# 9. Tests
# -----------------------------------------------------------------------------
[{tests/**,**/tests/**}]
dotnet_diagnostic.RS0030.severity = none
dotnet_diagnostic.CA1307.severity = none        # string comparison in tests
dotnet_diagnostic.CA1707.severity = none        # underscores in test names
dotnet_diagnostic.CA1852.severity = none
dotnet_diagnostic.CA2000.severity = none
dotnet_diagnostic.S112.severity = none
dotnet_diagnostic.S2699.severity = none         # tests verifying implicit execution/no throws
dotnet_diagnostic.S6612.severity = none
dotnet_diagnostic.MA0002.severity = none
dotnet_diagnostic.MA0006.severity = none
dotnet_diagnostic.MA0009.severity = none
dotnet_diagnostic.MA0011.severity = none
dotnet_diagnostic.SA1402.severity = none
dotnet_diagnostic.SA1649.severity = none
dotnet_diagnostic.IDE0130.severity = none
dotnet_naming_rule.async_suffix.severity = none
dotnet_naming_rule.members_pascal.severity = none

# -----------------------------------------------------------------------------
# 10. Generated code: never analyzed
# -----------------------------------------------------------------------------
[{**/Migrations/**.cs,**/*.Designer.cs,**/*.g.cs,**/obj/**.cs}]
generated_code = true
dotnet_analyzer_diagnostic.severity = none
